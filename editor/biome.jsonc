{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!!**/dist", "!bun.lock"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // noUncheckedIndexedAccess types every index as possibly undefined; `!` marks the indices a
        // preceding length check or loop bound guarantees, where a fallback value would hide a bad frame.
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // NumberField (components/controls.tsx) renders the <input> its <label> wraps.
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["NumberField"] } }
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
